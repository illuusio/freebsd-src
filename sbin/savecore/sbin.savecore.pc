Name: savecore
Description: save a core dump of the operating system
URL: https://man.freebsd.org/cgi/man.cgi?query=savecore&manpath=FreeBSD+15.0-RELEASE
Version: 15.0
License: NOASSERTION
Source: https://cgit.freebsd.org/src/tree/sbin/savecore?h=stable/15
Requires: lib.csu \
	lib.libc \
	lib.libcapsicum \
	lib.libcompiler_rt \
	lib.libxo.libxo \
	lib.libz \
	lib.libzstd
