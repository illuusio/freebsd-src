Name: geom
Description: universal control utility for GEOM classes
URL: https://man.freebsd.org/cgi/man.cgi?query=geom&manpath=FreeBSD+15.0-RELEASE
Version: 15.0
License: NOASSERTION
Source: https://cgit.freebsd.org/src/tree/sbin/geom/core?h=stable/15
Requires: lib.csu \
	lib.libc \
	lib.libcompiler_rt \
	lib.libexpat \
	lib.libgeom \
	lib.libsbuf \
	lib.libutil
