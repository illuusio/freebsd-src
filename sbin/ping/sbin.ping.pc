# SPDX-License-Identifier: FreeBSD-DOC and LicenseRef-FreeBSD-SBOM
Name: ping
Description: send ICMP or ICMPv6 ECHO_REQUEST packets to network hosts
URL: https://man.freebsd.org/cgi/man.cgi?query=ping&manpath=FreeBSD+15.0-RELEASE
Version: 15.0
License: NOASSERTION
Source: https://cgit.freebsd.org/src/tree/sbin/ping?h=stable/15
Requires: lib.csu \
	lib.libc \
	lib.libcapsicum \
	lib.libcompiler_rt \
	lib.libipsec \
	lib.libmd \
	lib.msun
