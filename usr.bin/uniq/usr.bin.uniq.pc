Name: uniq
Description: report or filter out repeated lines in a file
URL: https://man.freebsd.org/cgi/man.cgi?query=uniq&manpath=FreeBSD+15.0-RELEASE
Version: 15.0
License: NOASSERTION
Source: https://cgit.freebsd.org/src/tree/usr.bin/uniq?h=stable/15
Requires: lib.csu \
	lib.libc \
	lib.libcapsicum \
	lib.libcasper.libcasper \
	lib.libcompiler_rt
