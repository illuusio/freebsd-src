# SPDX-License-Identifier: FreeBSD-DOC and LicenseRef-FreeBSD-SBOM
Name: systat
Description: display system statistics
URL: https://man.freebsd.org/cgi/man.cgi?query=systat&manpath=FreeBSD+15.0-RELEASE
Version: 15.0
License: NOASSERTION
Source: https://cgit.freebsd.org/src/tree/usr.bin/systat?h=stable/15
Requires: lib.csu \
	lib.libc \
	lib.libcompiler_rt \
	lib.libdevstat \
	lib.libkvm \
	lib.libprocstat \
	lib.libutil \
	lib.msun \
	lib.ncurses.ncurses \
	lib.ncurses.tinfo
