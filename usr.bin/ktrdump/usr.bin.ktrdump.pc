Name: ktrdump
Description: print kernel ktr trace buffer
URL: https://man.freebsd.org/cgi/man.cgi?query=ktrdump&manpath=FreeBSD+15.0-RELEASE
Version: 15.0
License: NOASSERTION
Source: https://cgit.freebsd.org/src/tree/usr.bin/ktrdump?h=stable/15
Requires: lib.csu \
	lib.libc \
	lib.libcapsicum \
	lib.libcasper.libcasper \
	lib.libcompiler_rt \
	lib.libkvm
