Name: dpv
Description: stream data from stdin or multiple paths with dialog progress view
URL: https://man.freebsd.org/cgi/man.cgi?query=dpv&manpath=FreeBSD+15.0-RELEASE
Version: 15.0
License: NOASSERTION
Source: https://cgit.freebsd.org/src/tree/usr.bin/dpv?h=stable/15
Requires: lib.csu \
	lib.libc \
	lib.libcompiler_rt \
	lib.libdpv \
	lib.libfigpar \
	lib.msun \
	lib.ncurses.tinfo
