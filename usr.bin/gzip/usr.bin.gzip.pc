Name: znew
Description: convert compressed files to gzipped files
URL: https://man.freebsd.org/cgi/man.cgi?query=znew&manpath=FreeBSD+15.0-RELEASE
Version: 15.0
License: NOASSERTION
Source: https://cgit.freebsd.org/src/tree/usr.bin/gzip?h=stable/15
Requires: lib.csu \
	lib.libc \
	lib.libcompiler_rt \
	lib.liblzma \
	lib.libz \
	lib.libzstd
