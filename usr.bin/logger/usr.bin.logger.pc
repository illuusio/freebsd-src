Name: logger
Description: make entries in the system log
URL: https://man.freebsd.org/cgi/man.cgi?query=logger&manpath=FreeBSD+15.0-RELEASE
Version: 15.0
License: NOASSERTION
Source: https://cgit.freebsd.org/src/tree/usr.bin/logger?h=stable/15
Requires: lib.csu \
	lib.libc \
	lib.libcapsicum \
	lib.libcasper.libcasper \
	lib.libcasper.services.cap_syslog \
	lib.libcompiler_rt
