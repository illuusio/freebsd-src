# SPDX-License-Identifier: FreeBSD-DOC and LicenseRef-FreeBSD-SBOM
Name: top
Description: display and update information about the top cpu processes
URL: https://man.freebsd.org/cgi/man.cgi?query=top&manpath=FreeBSD+15.0-RELEASE
Version: 15.0
License: NOASSERTION
Source: https://cgit.freebsd.org/src/tree/usr.bin/top?h=stable/15
Requires: lib.csu \
	lib.libc \
	lib.libcompiler_rt \
	lib.libjail \
	lib.libkvm \
	lib.libsbuf \
	lib.libutil \
	lib.msun \
	lib.ncurses.tinfo
