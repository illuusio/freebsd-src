Name: fuser
Description: list IDs of all processes that have one or more files open
URL: https://man.freebsd.org/cgi/man.cgi?query=fuser&manpath=FreeBSD+15.0-RELEASE
Version: 15.0
License: NOASSERTION
Source: https://cgit.freebsd.org/src/tree/usr.bin/fstat?h=stable/15
Requires: lib.csu \
	lib.libc \
	lib.libcompiler_rt \
	lib.libprocstat
