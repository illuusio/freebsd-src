Name: procstat
Description: get detailed process information
URL: https://man.freebsd.org/cgi/man.cgi?query=procstat&manpath=FreeBSD+15.0-RELEASE
Version: 15.0
License: NOASSERTION
Source: https://cgit.freebsd.org/src/tree/usr.bin/procstat?h=stable/15
Requires: lib.csu \
	lib.libc \
	lib.libcompiler_rt \
	lib.libprocstat \
	lib.libsbuf \
	lib.libutil \
	lib.libxo.libxo
