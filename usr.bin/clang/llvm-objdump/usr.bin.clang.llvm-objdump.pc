# SPDX-License-Identifier: FreeBSD-DOC and LicenseRef-FreeBSD-SBOM
Name: llvm-objdump
Description: LLVM's object file dumper
URL: https://man.freebsd.org/cgi/man.cgi?query=llvm-objdump&manpath=FreeBSD+15.0-RELEASE
Version: 15.0
License: NOASSERTION
Source: https://cgit.freebsd.org/src/tree/usr.bin/clang/llvm-objdump?h=stable/15
Requires: lib.csu \
	lib.clang.libllvm \
	lib.libc \
	lib.libc++ \
	lib.libcompiler_rt \
	lib.libcxxrt \
	lib.libexecinfo \
	lib.libthr \
	lib.libz \
	lib.libzstd \
	lib.msun \
	lib.ncurses.tinfo
