# SPDX-License-Identifier: FreeBSD-DOC and LicenseRef-FreeBSD-SBOM
Name: llvm-profdata
Description: Profile data tool
URL: https://man.freebsd.org/cgi/man.cgi?query=llvm-profdata&manpath=FreeBSD+15.0-RELEASE
Version: 15.0
License: NOASSERTION
Source: https://cgit.freebsd.org/src/tree/usr.bin/clang/llvm-profdata?h=stable/15
Requires: lib.csu \
	lib.clang.libllvm \
	lib.libc \
	lib.libc++ \
	lib.libcompiler_rt \
	lib.libcxxrt \
	lib.libthr \
	lib.libz \
	lib.msun \
	lib.ncurses.ncursesw
