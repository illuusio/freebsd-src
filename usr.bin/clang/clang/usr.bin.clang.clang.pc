# SPDX-License-Identifier: FreeBSD-DOC and LicenseRef-FreeBSD-SBOM
Name: clang
Description: the Clang C, C++, and Objective-C compiler
URL: https://man.freebsd.org/cgi/man.cgi?query=clang&manpath=FreeBSD+15.0-RELEASE
Version: 15.0
License: NOASSERTION
Source: https://cgit.freebsd.org/src/tree/usr.bin/clang/clang?h=stable/15
Requires: lib.csu \
	lib.clang.libclang \
	lib.clang.libllvm \
	lib.libc \
	lib.libc++ \
	lib.libcompiler_rt \
	lib.libcxxrt \
	lib.libexecinfo \
	lib.libthr \
	lib.libz \
	lib.libzstd \
	lib.msun \
	lib.ncurses.ncurses \
	lib.ncurses.tinfo
