Name: vmstat
Description: report virtual memory statistics
URL: https://man.freebsd.org/cgi/man.cgi?query=vmstat&manpath=FreeBSD+15.0-RELEASE
Version: 15.0
License: NOASSERTION
Source: https://cgit.freebsd.org/src/tree/usr.bin/vmstat?h=stable/15
Requires: lib.csu \
	lib.libc \
	lib.libcompiler_rt \
	lib.libdevstat \
	lib.libkvm \
	lib.libmemstat \
	lib.libutil \
	lib.libxo.libxo
