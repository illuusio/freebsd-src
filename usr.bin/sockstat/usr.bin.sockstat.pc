	lib.libcapsicum \
	lib.libcasper.libcasper \
	lib.libcasper.services.cap_net \
	lib.libcasper.services.cap_netdb \
	lib.libcasper.services.cap_pwd \
	lib.libcasper.services.cap_sysctl \
	lib.libcompiler_rt \
	lib.libjail
