# SPDX-License-Identifier: FreeBSD-DOC and LicenseRef-FreeBSD-SBOM
Name: bhyve
Description: run a guest operating system inside a virtual machine
URL: https://man.freebsd.org/cgi/man.cgi?query=bhyve&manpath=FreeBSD+15.0-RELEASE
Version: 15.0
License: NOASSERTION
Source: https://cgit.freebsd.org/src/tree/usr.sbin/bhyve?h=stable/15
Requires: lib.csu \
	lib.lib9p \
	lib.libc \
	lib.libcam \
	lib.libcapsicum \
	lib.libcasper.libcasper \
	lib.libcompiler_rt \
	lib.libnetgraph \
	lib.libnv \
	lib.libsbuf \
	lib.libthr \
	lib.libutil \
	lib.libvmmapi \
	lib.libz
