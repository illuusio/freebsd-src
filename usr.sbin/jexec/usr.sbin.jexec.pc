Name: jexec
Description: execute a command inside an existing jail
URL: https://man.freebsd.org/cgi/man.cgi?query=jexec&manpath=FreeBSD+15.0-RELEASE
Version: 15.0
License: NOASSERTION
Source: https://cgit.freebsd.org/src/tree/usr.sbin/jexec?h=stable/15
Requires: lib.csu \
	lib.libc \
	lib.libcompiler_rt \
	lib.libjail \
	lib.libutil
