# SPDX-License-Identifier: FreeBSD-DOC and LicenseRef-FreeBSD-SBOM
Name: ctld
Description: CAM Target Layer / iSCSI target daemon
URL: https://man.freebsd.org/cgi/man.cgi?query=ctld&manpath=FreeBSD+15.0-RELEASE
Version: 15.0
License: NOASSERTION
Source: https://cgit.freebsd.org/src/tree/usr.sbin/ctld?h=stable/15
Requires: lib.csu \
	lib.libc \
	lib.libcapsicum \
	lib.libcasper.libcasper \
	lib.libcompiler_rt \
	lib.libexpat \
	lib.libiscsiutil \
	lib.libmd \
	lib.libnv \
	lib.libsbuf \
	lib.libucl \
	lib.libutil \
	lib.msun
