Name: pmcstat
Description: performance measurement with performance monitoring hardware
URL: https://man.freebsd.org/cgi/man.cgi?query=pmcstat&manpath=FreeBSD+15.0-RELEASE
Version: 15.0
License: NOASSERTION
Source: https://cgit.freebsd.org/src/tree/usr.sbin/pmcstat?h=stable/15
Requires: lib.csu \
	lib.libc \
	lib.libc++ \
	lib.libcompiler_rt \
	lib.libcxxrt \
	lib.libelf \
	lib.libkvm \
	lib.libpmc \
	lib.libpmcstat \
	lib.msun \
	lib.ncurses.ncurses \
	lib.ncurses.tinfo
