Name: iscsid
Description: iSCSI initiator daemon
URL: https://man.freebsd.org/cgi/man.cgi?query=iscsid&manpath=FreeBSD+15.0-RELEASE
Version: 15.0
License: NOASSERTION
Source: https://cgit.freebsd.org/src/tree/usr.sbin/iscsid?h=stable/15
Requires: lib.csu \
	lib.libc \
	lib.libcapsicum \
	lib.libcasper.libcasper \
	lib.libcompiler_rt \
	lib.libiscsiutil \
	lib.libmd \
	lib.libutil
