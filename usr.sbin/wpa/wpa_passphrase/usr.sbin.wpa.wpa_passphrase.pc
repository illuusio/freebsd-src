Version: 15.0
License: NOASSERTION
Source: https://cgit.freebsd.org/src/tree/usr.sbin/wpa/wpa_passphrase?h=stable/15
Requires: lib.csu \
	lib.libc \
	lib.libcompiler_rt \
	lib.libutil
